---
import "../styles/global.css";
import {
  appStoreUrl,
  getAlternates,
  legalUrls,
  localeCodes,
  localeLabels,
  localePath,
  locales,
  pages,
  siteUrl,
  type Locale
} from "@/data/site";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  image?: string;
  structuredData?: Record<string, unknown>[];
};

const { locale, title, description, path = "", image = "/assets/og-cover.png", structuredData = [] } = Astro.props;
const copy = pages[locale];
const canonical = `${siteUrl}${localePath(locale, path)}`;
const alternates = getAlternates(path);
const ogImage = `${siteUrl}${image}`;
const languageCode = localeCodes[locale];
---

<!doctype html>
<html lang={languageCode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([hreflang, href]) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${localePath("en", path)}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.appName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f7faf9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {structuredData.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <header class="site-header">
      <a class="brand-mark" href={localePath(locale)} aria-label={copy.appName}>
        <span class="brand-symbol">墨</span>
        <span>{copy.appName}</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href={`${localePath(locale)}#features`}>{copy.nav.features}</a>
        <a href={localePath(locale, "security")}>{copy.nav.security}</a>
        <a href={localePath(locale, "faq")}>{copy.nav.faq}</a>
      </nav>
      <div class="header-actions">
        <details class="language-menu">
          <summary>{localeLabels[locale]}</summary>
          <div class="language-panel">
            {locales.map((item) => <a href={localePath(item, path)}>{localeLabels[item]}</a>)}
          </div>
        </details>
        <a class="header-download" href={appStoreUrl}>{copy.nav.download}</a>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <a class="brand-mark footer-brand" href={localePath(locale)}>
          <span class="brand-symbol">墨</span>
          <span>{copy.appName}</span>
        </a>
        <p>{copy.footer.tagline}</p>
      </div>
      <div class="footer-links">
        <a href={legalUrls.privacy}>{copy.footer.privacy}</a>
        <a href={legalUrls.terms}>{copy.footer.terms}</a>
        <a href={appStoreUrl}>App Store</a>
      </div>
    </footer>
  </body>
</html>
