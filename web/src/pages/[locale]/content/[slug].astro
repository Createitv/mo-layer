---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import { contentIndex } from '../../../content-index';
import { generatedArticles } from '../../../generated-articles';
import { getCopy } from '../../../i18n/copy';
import { defaultLocale, localeCodes, type LocaleCode } from '../../../i18n/locales';
import { canonicalUrl, siteBase } from '../../../lib/seo';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return [
    ...articles.map((article) => ({
      params: { locale: article.data.locale, slug: article.data.pageSlug },
      props: { markdownArticle: article }
    })),
    ...generatedArticles.map((article) => ({
      params: { locale: article.locale, slug: article.slug },
      props: { generatedArticle: article }
    }))
  ];
}

const { markdownArticle, generatedArticle } = Astro.props;
const articleData = markdownArticle?.data ?? generatedArticle;
const locale = Astro.params.locale as LocaleCode;
if (!articleData || !localeCodes.includes(locale)) {
  return Astro.redirect('/en-US/');
}
const renderedArticle = markdownArticle ? await render(markdownArticle) : null;
const Content = renderedArticle?.Content;
const pageSlug = markdownArticle?.data.pageSlug ?? generatedArticle.slug;
const path = `/content/${pageSlug}`;
const site = siteBase(Astro.site);
const copy = getCopy(locale);
const author = {
  '@type': 'Person',
  '@id': 'https://lingxiaoyao.cn/#person',
  name: '林逍遥',
  url: 'https://lingxiaoyao.cn',
  email: 'xfy150150@gmail.com'
};
const publisher = {
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: locale === 'zh-Hans' ? '墨层' : locale === 'zh-Hant' ? '墨層' : 'Mo Layer',
  url: `${site}/${locale}/`
};
const translatedArticles = contentIndex.filter((entry) => entry.translationKey === articleData.translationKey);
const hreflangLinks = translatedArticles.map((entry) => ({
  hrefLang: entry.locale,
  href: canonicalUrl(site, entry.locale, `/content/${entry.slug}`)
}));
const defaultArticle = translatedArticles.find((entry) => entry.locale === defaultLocale) ?? translatedArticles[0];
if (defaultArticle) {
  hreflangLinks.push({
    hrefLang: 'x-default',
    href: canonicalUrl(site, defaultArticle.locale, `/content/${defaultArticle.slug}`)
  });
}
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: articleData.title,
    description: articleData.description,
    inLanguage: locale,
    keywords: articleData.keywords,
    author,
    publisher,
    datePublished: articleData.updatedAt,
    dateModified: articleData.updatedAt,
    url: `${site}/${locale}/content/${pageSlug}/`,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `${site}/${locale}/content/${pageSlug}/`
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Mo Layer', item: `${site}/${locale}/` },
      { '@type': 'ListItem', position: 2, name: copy.nav.content, item: `${site}/${locale}/content/${pageSlug}/` }
    ]
  }
];
---

<BaseLayout
  locale={locale}
  title={articleData.title}
  description={articleData.description}
  path={path}
  hreflangLinks={hreflangLinks}
  structuredData={structuredData}
>
  <section class="container article-shell">
    <article class="article-body">
      {Content ? (
        <Content />
      ) : (
        generatedArticle.blocks.map((block, index) => (
          <>
            {index === 0 ? <h1>{block.heading}</h1> : <h2>{block.heading}</h2>}
            {block.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {block.bullets && (
              <ul>
                {block.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            )}
          </>
        ))
      )}
    </article>
    <aside class="article-aside">
      <div class="privacy-panel">
        <strong>{copy.labels.contentTitle}</strong>
        <p>{articleData.description}</p>
        <a class="button secondary" href={`/${locale}/feedback/`}>{copy.feedback.title}</a>
      </div>
    </aside>
  </section>
</BaseLayout>
